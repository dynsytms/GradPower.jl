        - # SEXS SoA table builder. Mirror of tables/ieesgo.jl, but the cross-device
        - # coupling is "exciter reads vm from a bus" rather than "governor reads w
        - # from a generator".
        - 
        - function _build_sexs_table_impl(psd)
        -     n = 0
        0     for device in psd.devices
        0         if device.dtype isa SEXS
        0             n += 1
        -         end
        0     end
        - 
        0     bus      = Vector{Int32}(undef, n)
        0     diff_ptr = Vector{Int32}(undef, n)
        0     ctrl_ptr = Vector{Int32}(undef, n)
        0     par_ptr  = Vector{Int32}(undef, n)
        - 
        0     TA_TB = Vector{Float64}(undef, n)
        0     TB    = Vector{Float64}(undef, n)
        0     K     = Vector{Float64}(undef, n)
        0     TE    = Vector{Float64}(undef, n)
        0     EMIN  = Vector{Float64}(undef, n)
        0     EMAX  = Vector{Float64}(undef, n)
        0     vref  = zeros(Float64, n)
        0     vr_idx = Vector{Int32}(undef, n)
        - 
        0     jac_pos = zeros(Int32, n, SEXS_JAC_NENTRIES)
        - 
        0     diff_dim = psd.diff_dim
        0     alg_dim  = psd.alg_dim
        0     net_ptr  = diff_dim + alg_dim
        - 
        -     k = 0
        0     for device in psd.devices
        0         device.dtype isa SEXS || continue
        0         k += 1
        0         exc = device.dtype
        - 
        0         bus[k]      = Int32(exc.bus)
        0         diff_ptr[k] = Int32(device.diff_ptr)
        0         ctrl_ptr[k] = Int32(device.ctrl_ptr)
        0         par_ptr[k]  = Int32(device.par_ptr)
        - 
        0         TA_TB[k] = exc.TA_TB
        0         TB[k]    = exc.TB
        0         K[k]     = exc.K
        0         TE[k]    = exc.TE
        0         EMIN[k]  = exc.EMIN
        0         EMAX[k]  = exc.EMAX
        - 
        -         # Map the exciter's `.bus` (raw PSS/E bus number) to the internal
        -         # 1-based bus index, then compute vr's global z-index.
        0         internal_bus = haskey(psd.layout === nothing ? Dict{Int,Int}() : Dict{Int,Int}(), 0) ? 0 : Int(exc.bus)
        -         # psd doesn't carry busmap; we resolve via ps.busmap at refresh time.
        0         vr_idx[k] = Int32(net_ptr + 2*(internal_bus - 1) + 1)
        0     end
        - 
        0     return SEXSTable(n, bus, diff_ptr, ctrl_ptr, par_ptr,
        -         TA_TB, TB, K, TE, EMIN, EMAX, vref, vr_idx, jac_pos)
        - end
        - 
        - # After set_dynamics! finishes, refresh vr_idx using ps.busmap (which maps
        - # raw bus number → internal 1-based index). The build pass above can't see
        - # ps; this is called from set_dynamics! once ps is wired.
        - function fix_sexs_vr_idx!(psd, ps)
        0     table = psd.layout.sexs
        0     table.n == 0 && return nothing
        0     net_ptr = psd.diff_dim + psd.alg_dim
        -     k = 0
        0     for device in psd.devices
        0         device.dtype isa SEXS || continue
        0         k += 1
        0         internal_bus = ps.busmap[Int(table.bus[k])]
        0         table.vr_idx[k] = Int32(net_ptr + 2*(internal_bus - 1) + 1)
        0     end
        0     return nothing
        - end
        - 
        - function refresh_sexs_table!(psd)
        0     table = psd.layout.sexs
        0     table.n == 0 && return nothing
        -     k = 0
        0     for device in psd.devices
        0         device.dtype isa SEXS || continue
        0         k += 1
        0         table.vref[k] = device.dtype.vref
        0     end
        0     @assert k == table.n
        0     return nothing
        - end
        - 
        - register_device!(:sexs;
        -     table_type = SEXSTable,
        -     builder    = _build_sexs_table_impl,
        -     class      = :exciter)
