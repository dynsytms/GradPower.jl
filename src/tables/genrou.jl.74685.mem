        - # Builder for GenrouTable.
        - #
        - # Also publishes GENROU_JAC_NENTRIES — the fixed count of (row, col)
        - # Jacobian entries each GENROU device contributes. The order is defined
        - # by `genrou_jac_positions!` / `genrou_jacobian_batch!` in
        - # src/kernels/genrou.jl; both must agree on the slot-to-entry mapping.
        - 
        - # 42 entries: 6 diff rows (3+3+3+3+8+1) + 4 alg rows (4+4+4+4) + 2 net rows (3+3).
        - # Row tallies (one-based diff row k):
        - #   diff[1]: 3, diff[2]: 3, diff[3]: 3, diff[4]: 3, diff[5]: 7+(1 if gov), diff[6]: 1
        - #   With governor wiring the batched kernel writes the w_idx coupling
        - #   directly via the d_pm column entry. Today GENROU has no exciter wiring
        - #   active in tracked cases; we reserve no slot for e_fd (0 entries) and a
        - #   single optional slot for p_m → see GENROU_JAC_PM_COL_SLOT below.
        - const GENROU_JAC_NENTRIES = 46  # 42 base + pm-col (43) + sat cross-cols (44,45) + efd-col (46)
        - const GENROU_JAC_PM_COL_SLOT = 43  # ∂f5/∂p_m when has_gov[k]; 0-fill when not wired
        - 
        - #
        - # This file is included from src/GradPower.jl AFTER both layout.jl (for the
        - # GenrouTable type) and dynamics.jl (which transitively includes
        - # generators.jl for the Genrou struct).
        - #
        - # The stub `build_genrou_table` defined in src/layout.jl delegates to
        - # `_build_genrou_table_impl` below.
        - 
        - """
        -     _build_genrou_table_impl(psd) -> GenrouTable
        - 
        - Scan `psd.devices` once and emit a struct-of-arrays table for every Genrou
        - generator. All vectors have length `n` = number of Genrou devices.
        - 
        - Control coupling fields (`has_gov`, `pm_idx`, `has_exc`, `efd_idx`) are
        - resolved from `psd.uvec_idx`, which `set_dynamics!` populates BEFORE
        - `build_layout!` is called.
        - 
        - `jac_pos` is allocated as an `n × 0` Int32 matrix; `preallocate_jacobian`
        - widens its second dimension.
        - """
        - function _build_genrou_table_impl(psd)
        -     # 1. Count generators. Using `isa Genrou` for narrowness — when GENSAL
        -     #    or another AbstractGeneratorType subtype is added, this filter
        -     #    will need to be revisited (likely a separate table per subtype).
        -     n = 0
        0     for device in psd.devices
        0         if device.dtype isa Genrou
        0             n += 1
        -         end
        0     end
        - 
        -     # 2. Allocate global pointer vectors.
        0     bus      = Vector{Int32}(undef, n)
        0     diff_ptr = Vector{Int32}(undef, n)
        0     alg_ptr  = Vector{Int32}(undef, n)
        0     ctrl_ptr = Vector{Int32}(undef, n)
        0     par_ptr  = Vector{Int32}(undef, n)
        - 
        -     # 3. Allocate parameter vectors (14 Genrou parameters incl. S1, S2).
        0     x_d    = Vector{Float64}(undef, n)
        0     x_q    = Vector{Float64}(undef, n)
        0     x_dp   = Vector{Float64}(undef, n)
        0     x_qp   = Vector{Float64}(undef, n)
        0     x_ddp  = Vector{Float64}(undef, n)
        0     xl     = Vector{Float64}(undef, n)
        0     H      = Vector{Float64}(undef, n)
        0     D      = Vector{Float64}(undef, n)
        0     T_d0p  = Vector{Float64}(undef, n)
        0     T_q0p  = Vector{Float64}(undef, n)
        0     T_d0dp = Vector{Float64}(undef, n)
        0     T_q0dp = Vector{Float64}(undef, n)
        0     S1     = Vector{Float64}(undef, n)
        0     S2     = Vector{Float64}(undef, n)
        - 
        -     # 4. Allocate control-coupling vectors.
        0     has_gov = Vector{Bool}(undef, n)
        0     has_exc = Vector{Bool}(undef, n)
        0     pm_idx  = Vector{Int32}(undef, n)
        0     efd_idx = Vector{Int32}(undef, n)
        - 
        -     # 5. jac_pos has a fixed count of entries per Genrou device — the
        -     #    count of nonzero (row, col) entries the GENROU Jacobian writes
        -     #    (see src/kernels/genrou.jl GENROU_JAC_NENTRIES). Allocated
        -     #    zero-filled; populated by `genrou_jac_positions!` when
        -     #    `preallocate_jacobian` runs. Zero is a "not yet populated"
        -     #    sentinel — the batched Jacobian @asserts against it.
        0     jac_pos = zeros(Int32, n, GENROU_JAC_NENTRIES)
        - 
        -     # 6. Single pass over devices, fill row k for each Genrou match.
        -     # gen.bus holds the EXTERNAL PSS/E bus number; `fix_genrou_bus_idx!`
        -     # (called after build_layout!) remaps it to the internal 1-based index
        -     # the kernel uses for vr/vi addressing. Tests with sequential 1..N
        -     # external numbering happened to work without the remap.
        0     uvec = psd.uvec_idx
        -     k = 0
        0     for device in psd.devices
        0         device.dtype isa Genrou || continue
        0         k += 1
        0         gen = device.dtype
        - 
        0         bus[k]      = Int32(gen.bus)
        0         diff_ptr[k] = Int32(device.diff_ptr)
        0         alg_ptr[k]  = Int32(device.alg_ptr)
        0         ctrl_ptr[k] = Int32(device.ctrl_ptr)
        0         par_ptr[k]  = Int32(device.par_ptr)
        - 
        -         # Parameters are already ratio-adjusted by set_ratio! earlier in
        -         # set_dynamics!, so reading them here is correct.
        0         x_d[k]    = gen.x_d
        0         x_q[k]    = gen.x_q
        0         x_dp[k]   = gen.x_dp
        0         x_qp[k]   = gen.x_qp
        0         x_ddp[k]  = gen.x_ddp
        0         xl[k]     = gen.xl
        0         H[k]      = gen.H
        0         D[k]      = gen.D
        0         T_d0p[k]  = gen.T_d0p
        0         T_q0p[k]  = gen.T_q0p
        0         T_d0dp[k] = gen.T_d0dp
        0         T_q0dp[k] = gen.T_q0dp
        0         S1[k]     = gen.S1
        0         S2[k]     = gen.S2
        - 
        -         # Control coupling: ctrl_ptr points at u[1] (e_fd); ctrl_ptr+1 is u[2] (p_m).
        -         # uvec_idx[slot] == 0 means no controller wired to that slot.
        0         cp = device.ctrl_ptr
        0         efd_routed = uvec[cp]
        0         pm_routed  = uvec[cp + 1]
        0         has_exc[k] = efd_routed != 0
        0         efd_idx[k] = Int32(efd_routed)
        0         has_gov[k] = pm_routed != 0
        0         pm_idx[k]  = Int32(pm_routed)
        0     end
        - 
        0     return GenrouTable(n, bus, diff_ptr, alg_ptr, ctrl_ptr, par_ptr,
        -         x_d, x_q, x_dp, x_qp, x_ddp, xl, H, D,
        -         T_d0p, T_q0p, T_d0dp, T_q0dp, S1, S2,
        -         has_gov, pm_idx, has_exc, efd_idx, jac_pos)
        - end
        - 
        - # After set_dynamics! finishes, remap each Genrou.bus from external PSSE
        - # bus number → internal 1-based bus index. Mirrors fix_sexs_vr_idx! and
        - # must run before preallocate_jacobian / any kernel call. Called from
        - # set_dynamics! once ps.busmap is available.
        - function fix_genrou_bus_idx!(psd, ps)
        0     table = psd.layout.genrou
        0     table.n == 0 && return nothing
        -     k = 0
        0     for device in psd.devices
        0         device.dtype isa Genrou || continue
        0         k += 1
        0         table.bus[k] = Int32(ps.busmap[Int(table.bus[k])])
        0     end
        0     return nothing
        - end
        - 
        - # Register with the device registry so build_layout! picks up Genrou
        - # without layout.jl having to know about it.
        - register_device!(:genrou;
        -     table_type = GenrouTable,
        -     builder    = _build_genrou_table_impl,
        -     class      = :generator)
