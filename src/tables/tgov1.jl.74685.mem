        - # TGOV1 SoA table builder. Mirrors tables/ieesgo.jl.
        - 
        - function _build_tgov1_table_impl(psd)
        -     n = 0
        0     for device in psd.devices
        0         if device.dtype isa TGOV1
        0             n += 1
        -         end
        0     end
        - 
        0     bus      = Vector{Int32}(undef, n)
        0     diff_ptr = Vector{Int32}(undef, n)
        0     alg_ptr  = Vector{Int32}(undef, n)
        0     ctrl_ptr = Vector{Int32}(undef, n)
        0     par_ptr  = Vector{Int32}(undef, n)
        - 
        0     R    = Vector{Float64}(undef, n)
        0     T1   = Vector{Float64}(undef, n)
        0     VMAX = Vector{Float64}(undef, n)
        0     VMIN = Vector{Float64}(undef, n)
        0     T2   = Vector{Float64}(undef, n)
        0     T3   = Vector{Float64}(undef, n)
        0     DT   = Vector{Float64}(undef, n)
        0     pref = zeros(Float64, n)
        - 
        0     w_idx = Vector{Int32}(undef, n)
        0     jac_pos = zeros(Int32, n, TGOV1_JAC_NENTRIES)
        - 
        0     uvec = psd.uvec_idx
        -     k = 0
        0     for device in psd.devices
        0         device.dtype isa TGOV1 || continue
        0         k += 1
        0         gov = device.dtype
        - 
        0         bus[k]      = Int32(gov.bus)
        0         diff_ptr[k] = Int32(device.diff_ptr)
        0         alg_ptr[k]  = Int32(device.alg_ptr)
        0         ctrl_ptr[k] = Int32(device.ctrl_ptr)
        0         par_ptr[k]  = Int32(device.par_ptr)
        - 
        0         R[k]    = gov.R
        0         T1[k]   = gov.T1
        0         VMAX[k] = gov.VMAX
        0         VMIN[k] = gov.VMIN
        0         T2[k]   = gov.T2
        0         T3[k]   = gov.T3
        0         DT[k]   = gov.DT
        - 
        0         w_routed = uvec[device.ctrl_ptr]
        0         w_idx[k] = Int32(w_routed)
        0     end
        - 
        0     return TGOV1Table(n, bus, diff_ptr, alg_ptr, ctrl_ptr, par_ptr,
        -         R, T1, VMAX, VMIN, T2, T3, DT, pref, w_idx, jac_pos)
        - end
        - 
        - function refresh_tgov1_table!(psd)
        0     table = psd.layout.tgov1
        0     table.n == 0 && return nothing
        -     k = 0
        0     for device in psd.devices
        0         device.dtype isa TGOV1 || continue
        0         k += 1
        0         table.pref[k] = device.dtype.pref
        0     end
        0     @assert k == table.n
        0     return nothing
        - end
        - 
        - register_device!(:tgov1;
        -     table_type = TGOV1Table,
        -     builder    = _build_tgov1_table_impl,
        -     class      = :governor)
